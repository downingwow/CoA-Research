      "excerpts": [
        {
          "line": 1,
          "text": "-- Road to De Other Side (map 937) opens again: DestinyWeaver scales its Normal tier (finder entry 402, band 15-59)."
        },
        {
          "line": 2,
          "text": "-- Vaults of the Inquisition (map 936) too: live realms closed it by hand to players and the Dungeon Finder while its"
        },
        {
          "line": 3,
          "text": "-- per-difficulty rules and melee were wrong; it scales 15-59 on Normal (finder entry 401)."
        },
        {
          "line": 4,
          "text": "DELETE FROM `disables` WHERE `sourceType` IN (2, 8) AND `entry` IN (936, 937);"
        },
        {
          "line": 5,
          "text": ""
        }
      ]
    },
