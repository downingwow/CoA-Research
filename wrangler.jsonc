{
  "name": "coa-research",
  "main": "worker.js",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./site",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/download/*",
      "/",
      "/index.html",
      "/portal.js",
      "/projects.js",
      "/feedback.js",
      "/spell-database.html",
      "/data/addon-directory.json",
      "/data/research.json",
      "/data/top-builds.json"
    ]
  },
  "workers_dev": true
}
