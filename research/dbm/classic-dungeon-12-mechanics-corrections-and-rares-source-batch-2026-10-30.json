      "path": "data/sql/updates/pending_db_world/rev_20261029_85_coa_custom_dungeons_melee.sql",
      "lineCount": 185,
      "sourceLines": [
        {
          "line": 1,
          "text": "-- Vaults of the Inquisition (map 936) and Road to De Other Side (map 937): melee per difficulty, measured."
        },
        {
          "line": 2,
          "text": "-- The Heroic/Mythic templates took their DamageModifier from c = 857.1 (Vaults) and 199.2 (Road) damage per point at"
        },
        {
          "line": 6,
          "text": "-- logs: Mythic the 2026-08-05 log, Heroic Mythic / 2.15 for bosses and / 2.5 for the rest."
        },
        {
          "line": 7,
          "text": "-- Normal keeps the level 25 targets of rev_20261029_81, which counted CoA.CreatureScaling.Dungeon.Damage (x1.5)"
        },
        {
          "line": 10,
          "text": "-- Road's three bosses get Heroic/Mythic templates like its trash (their Normal target at level 25 is the Mythic log"
        },
        {
          "line": 11,
          "text": "-- times 0.12, the share of Road's trash). Generated by dungeon-recherche/custom_dungeon_melee.py."
        },
        {
          "line": 13,
          "text": "-- Road to De Other Side bosses: Heroic and Mythic templates"
        },
        {
          "line": 14,
          "text": "INSERT INTO `creature_template` (`entry`, `difficulty_entry_1`, `difficulty_entry_2`, `difficulty_entry_3`, `KillCredit1`, `KillCredit2`, `name`, `subname`, `IconName`, `gossip_menu_id`, `minlevel`, `maxlevel`, `exp`, `faction`, `npcflag`, `speed_walk`, `speed_run`, `speed_swim`, `speed_flight`, `detection_range`, `rank`, `dmgschool`, `DamageModifier`, `BaseAttackTime`, `RangeAttackTime`, `BaseVariance`, `RangeVariance`, `unit_class`, `unit_flags`, `unit_flags2`, `dynamicflags`, `family`, `type`, `type_flags`, `lootid`, `pickpocketloot`, `skinloot`, `PetSpellDataId`, `VehicleId`, `mingold`, `maxgold`, `AIName`, `MovementType`, `HoverHeight`, `HealthModifier`, `ManaModifier`, `ArmorModifier`, `ExperienceModifier`, `RacialLeader`, `movementId`, `RegenHealth`, `CreatureImmunitiesId`, `flags_extra`, `ScriptName`, `VerifiedBuild`) VALUES"
        },
