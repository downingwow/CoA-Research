      "excerpts": [
        {
          "line": 1,
          "text": "-- Vaults of the Inquisition (map 936): every spawn was placed in game with `.npc add` / `.gobject add` and kept their"
        },
        {
          "line": 2,
          "text": "-- 300 s respawn, so trash and bosses came back while the group was still inside (#10038, #10047). One day, as the"
        },
        {
          "line": 3,
          "text": "-- vanilla dungeons."
        },
        {
          "line": 4,
          "text": "UPDATE `creature` SET `spawntimesecs` = 86400 WHERE `map` = 936 AND `spawntimesecs` = 300;"
        },
        {
          "line": 5,
          "text": "UPDATE `gameobject` SET `spawntimesecs` = 86400 WHERE `map` = 936 AND `spawntimesecs` = 300;"
        },
        {
          "line": 6,
          "text": ""
        }
