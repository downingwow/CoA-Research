    {
      "path": "data/sql/updates/pending_db_world/rev_20261009_20_dungeon_fixes.sql",
      "lineCount": 27,
      "sourceLines": [
        {
          "line": 1,
          "text": "-- Dungeon fixes: Fierce Blow, Tomb Fiend, Landslide."
        },
        {
          "line": 3,
          "text": "-- Fierce Blow (975011) in the bosses' SmartAI kits went out at 200 % weapon damage and triggered,"
        },
        {
          "line": 4,
          "text": "-- so it ignored a running cast. Boss melee damage is restored now, so it goes back to the spell's own"
        },
        {
          "line": 5,
          "text": "-- 100 %, and it is cast untriggered: the core makes it an on-next-swing strike (SpellInfoCorrections),"
        },
        {
          "line": 7,
          "text": "UPDATE `smart_scripts` SET `action_param2` = 0, `action_param3` = 100"
        },
        {
          "line": 8,
          "text": "WHERE `action_type` = 218 AND `action_param1` = 975011;"
        },
        {
          "line": 10,
          "text": "-- Tomb Fiend (Razorfen Downs) is a normal creature but had an elite's health (HealthModifier 4,"
        },
        {
          "line": 12,
          "text": "UPDATE `creature_template` SET `HealthModifier` = 1.1 WHERE `entry` = 7349;"
        },
        {
          "line": 14,
          "text": "-- Damage multiplier for single creatures in dungeons: melee, spells and periodic damage, every"
        },
        {
          "line": 15,
          "text": "-- difficulty (CoADungeonSpellDamage.cpp)."
        },
        {
          "line": 16,
          "text": "CREATE TABLE IF NOT EXISTS `coa_dungeon_creature_damage` ("
        },
        {
          "line": 17,
          "text": "    `entry`      INT UNSIGNED NOT NULL,"
        },
        {
          "line": 18,
          "text": "    `multiplier` FLOAT NOT NULL DEFAULT 1,"
        },
        {
          "line": 19,
          "text": "    `comment`    VARCHAR(255) NOT NULL DEFAULT '',"
        },
        {
          "line": 20,
          "text": "    PRIMARY KEY (`entry`)"
        },
        {
          "line": 21,
          "text": ") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;"
        },
        {
          "line": 24,
          "text": "DELETE FROM `coa_dungeon_creature_damage` WHERE `entry` = 12203;"
        },
        {
          "line": 25,
          "text": "INSERT INTO `coa_dungeon_creature_damage` (`entry`, `multiplier`, `comment`) VALUES"
        },
        {
          "line": 26,
          "text": "(12203, 0.6, 'Landslide: all damage -40 %');"
        }
      ],
      "spellIds": [
        975011
      ]
    },
    {
      "path": "data/sql/updates/pending_db_world/rev_20261028_02_dungeon_normal_fierce_blow.sql",
      "lineCount": 15,
      "sourceLines": [
        {
          "line": 1,
          "text": "-- Fierce Blow (975011, SPELL_EFFECT_WEAPON_PERCENT_DAMAGE) is cast by many restored Ascension boss"
        },
        {
          "line": 2,
          "text": "-- kits (rev_20261001_10_boss_kits_scripted.sql and others) but is absent from"
        },
        {
          "line": 3,
          "text": "-- coa_dungeon_normal_spell_damage, so CoADungeonNormal::TunesSpell() never recognizes it: on Normal"
        },
        {
          "line": 4,
          "text": "-- it lands raw, with no Normal-rank reduction and no CoA.DungeonNormal.TargetHitCapPct cap, able to"
        },
        {
          "line": 7,
          "text": "-- SPELL_EFFECT_WEAPON_DAMAGE rank, not comparable), so this follows the same table's existing pattern"
        },
        {
          "line": 8,
          "text": "-- for spells without one (normal_spell_id = 0, high = Heroic damage / 1.66 * 0.85, e.g. 15232 Shadow"
        },
        {
          "line": 9,
          "text": "-- Bolt, 22689 Mangle, 391369 Rend): CoADungeonNormal::Factor() returns `high` unconditionally when"
        },
        {
          "line": 10,
          "text": "-- normal_spell_id is 0, then the existing single-target 40% max-health cap (TargetCapPct) applies."
        },
        {
          "line": 12,
          "text": "DELETE FROM `coa_dungeon_normal_spell_damage` WHERE `spell_id` = 975011;"
        },
        {
          "line": 13,
          "text": "INSERT INTO `coa_dungeon_normal_spell_damage` (`spell_id`, `normal_spell_id`, `high`, `comment`) VALUES"
        },
        {
          "line": 14,
          "text": "(975011, 0, 0.512, 'Fierce Blow: Heroic / 1.66 * 0.85, matches Normal dungeon kit softening (#9297, #9344)');"
        }
      ],
      "spellIds": [
        975011,
        9297
      ]
    },
